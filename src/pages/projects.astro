---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { techIcons } from '../lib/techIcons';

const allProjects = await getCollection('projects');
const projects = allProjects.map(p => p.data).sort((a, b) => a.order - b.order);

const featured = projects.filter(p => p.featured);
const rest = projects.filter(p => !p.featured);

const allTags = [...new Set(projects.flatMap(p => p.tags))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="A full collection of software engineering, data science, ML, and academic projects by Itziar Morales Rodríguez." />
	</head>
	<body>
		<Header />
		<main>
			<section class="projects-page">
				<p class="eyebrow">~/projects</p>
				<h1>All Projects</h1>
				<p class="intro">
					Software engineering, data science, ML, game dev, and academic projects.
					Each card links directly to the repository, notebook, or demo.
				</p>

				<!-- Tag filter bar -->
				<div class="filter-bar">
					<button class="filter-pill active" data-tag="all">All</button>
					{allTags.map(tag => (
						<button class="filter-pill" data-tag={tag}>{tag}</button>
					))}
				</div>

				<!-- Featured projects -->
				{featured.length > 0 && (
					<h2 class="section-label">Pinned</h2>
				)}
				{featured.length > 0 && (
					<div class="featured-grid" id="featured-section">
						{featured.map((project) => (
							<div class="proj-card proj-card--featured" data-tags={project.tags.join(',').toLowerCase()}>
								{project.link
									? (
										<a class="proj-card-inner" href={project.link} target="_blank" rel="noopener">
											<div class="tags">
												<span class="featured-badge">Featured</span>
												<span class={`origin origin-${project.origin.toLowerCase().replace(/[^a-z]/g, '')}`}>{project.origin}</span>
												{project.tags.map(tag => <span class="tag">{tag}</span>)}
												{project.blogSlug && <span class="tag tag-post">Post ✏️</span>}
											</div>
											<h2>{project.title}</h2>
											<p class="summary">{project.summary}</p>
											<p class="highlight">{project.highlight}</p>
											<div class="tech-icons" aria-hidden="true">
												{techIcons(project.tech).map((i) => <Icon name={i} />)}
											</div>
											<p class="tech">{project.tech}</p>
											<span class="card-cta">Open ↗</span>
										</a>
									)
									: (
										<div class="proj-card-inner proj-card-inner--no-link">
											<div class="tags">
												<span class="featured-badge">Featured</span>
												<span class={`origin origin-${project.origin.toLowerCase().replace(/[^a-z]/g, '')}`}>{project.origin}</span>
												{project.tags.map(tag => <span class="tag">{tag}</span>)}
												{project.blogSlug && <span class="tag tag-post">Post ✏️</span>}
											</div>
											<h2>{project.title}</h2>
											<p class="summary">{project.summary}</p>
											<p class="highlight">{project.highlight}</p>
											<div class="tech-icons" aria-hidden="true">
												{techIcons(project.tech).map((i) => <Icon name={i} />)}
											</div>
											<p class="tech">{project.tech}</p>
											<span class="card-cta no-link">Coming soon</span>
										</div>
									)
								}
								<div class="card-footer">
									{project.githubUrl && (
										<a class="footer-link" href={project.githubUrl} target="_blank" rel="noopener">GitHub ↗</a>
									)}
									{project.externalUrl && (
										<a class="footer-link" href={project.externalUrl} target="_blank" rel="noopener">{project.externalLabel ?? 'Open ↗'}</a>
									)}
									{project.blogSlug && (
										<a class="footer-link" href={`/notes/${project.blogSlug}`}>Read post →</a>
									)}
								</div>
							</div>
						))}
					</div>
				)}

				<!-- Rest of projects -->
				<h2 class="section-label">The rest</h2>
				<div class="projects-grid" id="projects-grid">
					{rest.map((project) => (
						<div class="proj-card" data-tags={project.tags.join(',').toLowerCase()}>
							{project.link
								? (
									<a class="proj-card-inner" href={project.link} target="_blank" rel="noopener">
										<div class="tags">
											<span class={`origin origin-${project.origin.toLowerCase().replace(/[^a-z]/g, '')}`}>{project.origin}</span>
											{project.tags.map(tag => <span class="tag">{tag}</span>)}
											{project.blogSlug && <span class="tag tag-post">Post ✏️</span>}
										</div>
										<h2>{project.title}</h2>
										<p class="summary">{project.summary}</p>
										<p class="highlight">{project.highlight}</p>
										<div class="tech-icons" aria-hidden="true">
												{techIcons(project.tech).map((i) => <Icon name={i} />)}
											</div>
											<p class="tech">{project.tech}</p>
										<span class="card-cta">Open ↗</span>
									</a>
								)
								: (
									<div class="proj-card-inner proj-card-inner--no-link">
										<div class="tags">
											<span class={`origin origin-${project.origin.toLowerCase().replace(/[^a-z]/g, '')}`}>{project.origin}</span>
											{project.tags.map(tag => <span class="tag">{tag}</span>)}
											{project.blogSlug && <span class="tag tag-post">Post ✏️</span>}
										</div>
										<h2>{project.title}</h2>
										<p class="summary">{project.summary}</p>
										<p class="highlight">{project.highlight}</p>
										<div class="tech-icons" aria-hidden="true">
												{techIcons(project.tech).map((i) => <Icon name={i} />)}
											</div>
											<p class="tech">{project.tech}</p>
										<span class="card-cta no-link">Coming soon</span>
									</div>
								)
							}
							<div class="card-footer">
								{project.githubUrl && (
									<a class="footer-link" href={project.githubUrl} target="_blank" rel="noopener">GitHub ↗</a>
								)}
								{project.externalUrl && (
									<a class="footer-link" href={project.externalUrl} target="_blank" rel="noopener">{project.externalLabel ?? 'Open ↗'}</a>
								)}
								{project.blogSlug && (
									<a class="footer-link" href={`/notes/${project.blogSlug}`}>Read post →</a>
								)}
							</div>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
	const featuredSection = document.getElementById('featured-section');
	const regularGrid = document.getElementById('projects-grid');

	const featuredCards = featuredSection
		? Array.from(featuredSection.querySelectorAll<HTMLElement>('.proj-card--featured'))
		: [];

	function applyFilter(tag: string) {
		const allCards = document.querySelectorAll<HTMLElement>('.proj-card');
		allCards.forEach(card => {
			const cardTags = card.dataset.tags ?? '';
			const visible = tag === 'all' || cardTags.split(',').includes(tag.toLowerCase());
			card.dataset.visible = visible ? 'true' : 'false';
		});

		const visibleFeatured = featuredCards.filter(c => c.dataset.visible === 'true');
		const useFeaturedLayout = visibleFeatured.length >= 2;

		if (useFeaturedLayout) {
			featuredCards.forEach(card => {
				if (featuredSection && card.parentElement !== featuredSection) {
					featuredSection.appendChild(card);
				}
				card.classList.add('proj-card--featured');
				card.style.display = card.dataset.visible === 'true' ? '' : 'none';
			});
			if (featuredSection) featuredSection.style.display = '';
		} else {
			if (featuredSection) featuredSection.style.display = 'none';
			featuredCards.forEach(card => {
				if (regularGrid && card.parentElement !== regularGrid) {
					regularGrid.prepend(card);
				}
				card.classList.remove('proj-card--featured');
				card.style.display = card.dataset.visible === 'true' ? '' : 'none';
			});
		}

		if (regularGrid) {
			Array.from(regularGrid.querySelectorAll<HTMLElement>('.proj-card')).forEach(card => {
				card.style.display = card.dataset.visible === 'true' ? '' : 'none';
			});
			regularGrid.style.display = '';
		}
	}

	pills.forEach(pill => {
		pill.addEventListener('click', () => {
			pills.forEach(p => p.classList.remove('active'));
			pill.classList.add('active');
			applyFilter(pill.dataset.tag!);
		});
	});
</script>

<style>
	.projects-page {
		padding: 0 0 3rem;
	}
	.projects-page h1 {
		margin-bottom: 0.6rem;
	}
	.intro {
		color: var(--text-muted);
		max-width: 42rem;
		margin-bottom: 1.5rem;
	}

	/* Filter bar */
	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.75rem;
	}
	.filter-pill {
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.3em 0.85em;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
		font-family: inherit;
	}
	.filter-pill:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.filter-pill.active {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Featured grid — 2-col */
	.featured-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	@media (max-width: 640px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Regular grid */
	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	/* Cards */
	.proj-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: 6px;
		background: var(--surface);
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
	}
	.proj-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 10%, transparent);
		transform: translateY(-2px);
	}
	.proj-card--featured {
		border-left-width: 4px;
		border-left-color: var(--accent-hot);
	}
	.proj-card--featured:hover {
		border-color: var(--accent-hot);
		box-shadow: 0 0 14px color-mix(in srgb, var(--accent-hot) 12%, transparent);
	}
	.proj-card--featured h2 a,
	.proj-card--featured > .proj-card-inner h2 {
		color: var(--accent-hot);
	}
	.proj-card-inner {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.25rem 0.75rem;
		text-decoration: none;
		gap: 0.4rem;
		flex: 1;
	}
	.proj-card-inner--no-link {
		cursor: default;
	}
	.proj-card--featured .proj-card-inner {
		padding: 1.5rem 1.75rem 1rem;
	}
	.proj-card h2 {
		font-size: 1rem;
		margin: 0;
		color: var(--accent);
	}
	.proj-card--featured h2 {
		font-size: 1.2rem;
	}
	.proj-card p {
		margin: 0;
		font-size: 0.88rem;
	}
	.proj-card .summary {
		color: var(--text);
	}
	.proj-card .highlight {
		color: var(--text-muted);
		font-size: 0.82rem;
	}
	.proj-card .tech {
		color: var(--text-muted);
		font-size: 0.78rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
	}
	.featured-badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.1em 0.45em;
		border-radius: 3px;
		background: color-mix(in srgb, var(--accent-hot) 14%, transparent);
		color: var(--accent-hot);
		border: 1px solid color-mix(in srgb, var(--accent-hot) 35%, transparent);
	}
	.origin {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.1em 0.45em;
		border-radius: 3px;
	}
	.origin-personal {
		background: color-mix(in srgb, var(--c-green) 10%, transparent);
		color: var(--c-green);
		border: 1px solid color-mix(in srgb, var(--c-green) 25%, transparent);
	}
	.origin-utad {
		background: color-mix(in srgb, var(--c-blue) 10%, transparent);
		color: var(--c-blue);
		border: 1px solid color-mix(in srgb, var(--c-blue) 25%, transparent);
	}
	.origin-digipen {
		background: color-mix(in srgb, var(--c-yellow) 10%, transparent);
		color: var(--c-yellow);
		border: 1px solid color-mix(in srgb, var(--c-yellow) 25%, transparent);
	}
	.card-cta {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 600;
		margin-top: 0.5rem;
	}
	.card-cta.no-link {
		color: var(--text-muted);
		opacity: 0.5;
	}
	.tag {
		font-size: 0.72rem;
		padding: 0.15em 0.55em;
		border-radius: 3px;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
		letter-spacing: 0.02em;
		font-weight: 500;
	}
	.tag-post {
		background: color-mix(in srgb, var(--c-green) 8%, transparent);
		color: var(--c-green);
		border-color: color-mix(in srgb, var(--c-green) 25%, transparent);
	}
	/* Card footer */
	.card-footer {
		display: flex;
		border-top: 1px solid var(--border);
	}
	.card-footer:empty {
		display: none;
	}
	.footer-link {
		flex: 1;
		padding: 0.5rem 1.25rem;
		color: var(--text-muted);
		font-size: 0.78rem;
		text-decoration: none;
		transition: color 0.15s ease;
		text-align: center;
	}
	.footer-link + .footer-link {
		border-left: 1px solid var(--border);
	}
	.footer-link:hover {
		color: var(--accent);
	}
	.tech-icons {
		display: flex;
		gap: 0.55em;
		align-items: center;
		margin-top: 0.4rem;
	}
	.tech-icons :global(svg) {
		width: 1.05em;
		height: 1.05em;
		color: var(--text-muted);
	}
	.section-label {
		font-size: 1.05em;
		color: var(--accent);
		margin: 2rem 0 1rem;
		padding-bottom: 0.4em;
		border-bottom: 1px solid var(--border);
	}
	.section-label::before {
		content: '## ';
		color: var(--text-muted);
	}
</style>
