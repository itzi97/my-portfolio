---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_URL, LINKEDIN_URL, EMAIL, CV_URL } from '../consts';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { techIcons } from '../lib/techIcons';

const nfArt = String.raw` _ _       _ 
(_) |_ ___(_)
| | __|_  / |
| | |_ / /| |
|_|\__/___|_|
             
`.trimEnd();

const nfRows: [string, string][] = [
	['host', 'U-tad, Madrid'],
	['kernel', 'Software Engineering + DS&AI'],
	['shell', 'fish'],
	['editor', 'Neovim'],
	['wm', 'Plasma / Hyprland'],
	['langs', 'es · en (C2) · fr (loading…)'],
];

const featuredProjects = (await getCollection('projects'))
	.filter(p => p.data.featured)
	.map(p => p.data)
	.sort((a, b) => a.order - b.order);

const latestPost = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">~/home</p>
				<h1>Itziar Morales</h1>
				<p class="tagline">Software Engineering Student · Data Science & AI Minor · Madrid, Spain</p>
				<p class="personality">I write C++ game engines for fun, train neural nets for class, and run a home server I definitely don't tinker with too much. These days I'm interning at MGA, turning years of spreadsheet workflows into a PostgreSQL + Spring Boot platform that enforces its own rules.</p>
				<div class="nf" aria-label="About me, neofetch style">
					<pre class="nf-art" aria-hidden="true">{nfArt}</pre>
					<div class="nf-info">
						<p class="nf-head">itziar<span class="nf-dim">@</span>itziar.dev</p>
						<p class="nf-sep" aria-hidden="true">─────────────────</p>
						{nfRows.map(([k, v]) => (
							<p class="nf-row"><span class="nf-key">{k}</span>{v}</p>
						))}
						<p class="nf-row"><span class="nf-key">mail</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
						<div class="nf-colors" aria-hidden="true">
							<span style="background: var(--accent-hot)"></span>
							<span style="background: var(--accent)"></span>
							<span style="background: var(--c-green)"></span>
							<span style="background: var(--c-blue)"></span>
							<span style="background: var(--c-yellow)"></span>
							<span style="background: var(--text-muted)"></span>
						</div>
					</div>
				</div>
				<nav class="links">
					<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
					<a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
					<a href="/about">About</a>
					<a href="/projects">Projects</a>
					<a href={CV_URL} target="_blank" rel="noopener">Download CV</a>
				</nav>
			</section>

			<section class="pulse">
				{latestPost && (
					<a class="pulse-item" href={`/notes/${latestPost.id}/`}>
						<span class="pulse-label">latest</span>
						<span class="pulse-text">{latestPost.data.title}</span>
					</a>
				)}
				<a class="pulse-item" href="/now">
					<span class="pulse-label">now</span>
					<span class="pulse-text">Final year looming, schemas by day, engine rewrite by night</span>
				</a>
			</section>

			<section class="projects" id="projects">
				<div class="section-heading">
					<div>
						<h2>Featured Projects</h2>
						<p>Selected projects below. Browse the full collection on the dedicated projects page.</p>
					</div>
					<a class="view-all" href="/projects">See all projects →</a>
				</div>

				{featuredProjects.map((project) => (
					<div class="proj-card">
						<a class="proj-card-inner" href={project.link} target="_blank" rel="noopener">
							<div class="tags">
								<span class="featured-badge">Featured</span>
								<span class={`origin origin-${project.origin.toLowerCase().replace(/[^a-z]/g, '')}`}>{project.origin}</span>
								{project.tags.map(tag => (
									<span class="tag">{tag}</span>
								))}
								{project.blogSlug && <span class="tag tag-post">Post ✏️</span>}
							</div>
							<h3>{project.title}</h3>
							<p class="summary">{project.summary}</p>
							<div class="tech-icons" aria-hidden="true">
								{techIcons(project.tech).map((i) => <Icon name={i} />)}
							</div>
							<p class="tech">{project.tech}</p>
							<span class="card-cta">Open ↗</span>
						</a>
						{project.blogSlug && (
							<div class="card-footer">
								<a class="footer-link" href={`/notes/${project.blogSlug}`}>Read post →</a>
							</div>
						)}
					</div>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>

	.personality {
		color: var(--text);
		font-size: 0.88em;
		margin-bottom: 0.75em;
	}

	.nf {
		display: flex;
		gap: 3rem;
		justify-content: flex-start;
		align-items: center;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent-hot);
		border-radius: 6px;
		background: var(--surface);
		padding: 1.15em 1.6em;
		margin: 1.25rem 0;
	}
	.nf-art {
		margin: 0;
		font-size: 1em;
		line-height: 1.25;
		color: var(--accent-hot);
		font-weight: 700;
		flex-shrink: 0;
	}
	.nf-info {
		min-width: 0;
	}
	.nf-head {
		margin: 0;
		font-size: 0.9em;
		font-weight: 600;
		color: var(--accent-hot);
	}
	.nf-dim {
		color: var(--text-muted);
		font-weight: 400;
	}
	.nf-sep {
		margin: 0 0 0.2em;
		color: var(--text-muted);
		font-size: 0.8em;
		line-height: 1.2;
	}
	.nf-row {
		margin: 0;
		font-size: 0.82em;
		line-height: 1.65;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.nf-key {
		display: inline-block;
		min-width: 4.4em;
		color: var(--accent);
		font-weight: 600;
	}
	.nf-colors {
		display: flex;
		gap: 0.3em;
		margin-top: 0.55em;
	}
	.nf-colors span {
		width: 1em;
		height: 0.65em;
		border-radius: 2px;
		display: inline-block;
	}
	@media (max-width: 560px) {
		.nf {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.9rem;
		}
		.nf-art {
			display: none;
		}
	}
	.tech-icons {
		display: flex;
		gap: 0.55em;
		align-items: center;
		margin-top: 0.4rem;
	}
	.tech-icons :global(svg) {
		width: 1.05em;
		height: 1.05em;
		color: var(--text-muted);
	}
	.pulse {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}
	.pulse-item {
		display: flex;
		align-items: baseline;
		gap: 0.75em;
		text-decoration: none;
		font-size: 0.88rem;
	}
	.pulse-label {
		font-family: var(--font-mono);
		color: var(--accent);
		font-size: 0.8em;
		min-width: 3.5em;
	}
	.pulse-text {
		color: var(--text-muted);
		transition: color 0.15s ease;
	}
	.pulse-item:hover .pulse-text {
		color: var(--accent);
	}
	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}
	.section-heading h2 {
		margin-bottom: 0.4rem;
	}
	.section-heading p {
		margin: 0;
		color: var(--text-muted);
		max-width: 40rem;
	}
	.view-all {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		white-space: nowrap;
	}
	.view-all:hover {
		text-decoration: underline;
	}

	.proj-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: 6px;
		background: var(--surface);
		margin-bottom: 1rem;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
	}
	.proj-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 10%, transparent);
		transform: translateY(-2px);
	}
	.proj-card-inner {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.25rem 0.75rem;
		text-decoration: none;
		gap: 0.4rem;
		flex: 1;
	}
	.proj-card h3 {
		font-size: 1rem;
		margin: 0;
		color: var(--accent);
	}
	.proj-card p {
		margin: 0;
		font-size: 0.88rem;
	}
	.proj-card .summary {
		color: var(--text);
	}
	.proj-card .tech {
		color: var(--text-muted);
		font-size: 0.78rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}
	.card-cta {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 600;
		margin-top: 0.5rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
	}
	.featured-badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.1em 0.45em;
		border-radius: 3px;
		background: color-mix(in srgb, var(--accent) 15%, transparent);
		color: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
	}
	.origin {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.1em 0.45em;
		border-radius: 3px;
	}
	.origin-personal {
		background: color-mix(in srgb, var(--c-green) 10%, transparent);
		color: var(--c-green);
		border: 1px solid color-mix(in srgb, var(--c-green) 25%, transparent);
	}
	.origin-utad {
		background: color-mix(in srgb, var(--c-blue) 10%, transparent);
		color: var(--c-blue);
		border: 1px solid color-mix(in srgb, var(--c-blue) 25%, transparent);
	}
	.origin-digipen {
		background: color-mix(in srgb, var(--c-yellow) 10%, transparent);
		color: var(--c-yellow);
		border: 1px solid color-mix(in srgb, var(--c-yellow) 25%, transparent);
	}
	.tag {
		font-size: 0.72rem;
		padding: 0.15em 0.55em;
		border-radius: 3px;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
		letter-spacing: 0.02em;
		font-weight: 500;
	}
	.tag-post {
		background: color-mix(in srgb, var(--c-green) 8%, transparent);
		color: var(--c-green);
		border-color: color-mix(in srgb, var(--c-green) 25%, transparent);
	}
	.card-footer {
		display: flex;
		border-top: 1px solid var(--border);
	}
	.footer-link {
		flex: 1;
		padding: 0.5rem 1.25rem;
		color: var(--text-muted);
		font-size: 0.78rem;
		text-decoration: none;
		transition: color 0.15s ease;
		text-align: center;
	}
	.footer-link:hover {
		color: var(--accent);
	}

</style>
