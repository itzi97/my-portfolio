---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="404 | Itziar Morales"
	description="No such file or directory."
>
	<p class="eyebrow">~/404</p>
	<h1>404</h1>

	<div class="session">
		<p class="line"><span class="prompt">❯</span> cat ~<span class="miss">/this-page</span></p>
		<p class="line err">cat: ~<span class="miss">/this-page</span>: No such file or directory</p>
		<p class="line"><span class="prompt">❯</span> <span class="cursor"></span></p>
	</div>

	<p class="hint">Try one of these instead:</p>
	<ul class="cmds">
		<li><a href="/"><span class="prompt">❯</span> cd ~</a></li>
		<li><a href="/projects"><span class="prompt">❯</span> ls ~/projects</a></li>
		<li><a href="/notes"><span class="prompt">❯</span> cat ~/notes/*</a></li>
		<li><a href="/about"><span class="prompt">❯</span> whoami</a></li>
	</ul>

	<script is:inline>
		const path = window.location.pathname.replace(/\/$/, '') || '/this-page';
		document.querySelectorAll('.miss').forEach((el) => { el.textContent = path; });
	</script>

	<style>
		.session {
			border: 1px solid var(--border);
			border-left: 3px solid var(--accent-hot);
			border-radius: 6px;
			background: var(--surface);
			padding: 1em 1.3em;
			margin: 1.5rem 0 2rem;
		}
		.line {
			margin: 0 0 0.3em;
			font-size: 0.92em;
			overflow-wrap: anywhere;
		}
		.prompt {
			color: var(--accent-hot);
			font-weight: 700;
			margin-right: 0.45em;
		}
		.err {
			color: var(--text-muted);
		}
		.hint {
			color: var(--text-muted);
			font-size: 0.9em;
			margin-bottom: 0.6em;
		}
		.cmds {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.4em;
		}
		.cmds a {
			font-size: 0.92em;
			color: var(--accent);
			text-decoration: none;
		}
		.cmds a:hover {
			color: var(--accent-hot);
			text-decoration: underline;
		}
	</style>
</PageLayout>
