---
import PageLayout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import fitness from '../content/fitness.json';

const updated = new Date('2026-07-24');

const fmt = (n: number) => n.toLocaleString('en-GB');
const monthLabel = fitness.month.label
	? new Date(`${fitness.month.label}-01`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toLowerCase()
	: 'this month';
---

<PageLayout
	title="Now | Itziar Morales"
	description="What I'm doing these days — a now page."
>
	<p class="eyebrow">~/now</p>
	<h1>Now</h1>
	<p class="updated">
		Last updated <time datetime={updated.toISOString().slice(0, 10)}>
			{updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
		</time> · this is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a>
	</p>

	<h2>Working</h2>
	<p>
		Interning remotely at MGA, deep in the data-engineering side of a digital transformation:
		relational schema design, migrating years of spreadsheet data into PostgreSQL, and Spring Boot
		services on top. Learning a lot about the gap between how a business says it works and what its
		data actually does.
	</p>

	<h2>Studying</h2>
	<p>
		Final year of Software Engineering at U-tad starts in September. Thesis brewing on the same theme
		as the internship: how you replace legacy spreadsheet workflows without breaking the people who
		rely on them.
	</p>
	<p>On the side:</p>
	<ul>
		<li><a href="https://www.udemy.com/course/spring-hibernate-tutorial/" target="_blank" rel="noopener">Spring &amp; Hibernate</a> (Udemy) &mdash; backend upskilling for work</li>
		<li><a href="https://www.udemy.com/course/sql-and-postgresql/" target="_blank" rel="noopener">SQL &amp; PostgreSQL</a> (Udemy) &mdash; same mission, database side</li>
		<li>French &mdash; chipping away, aiming for a DELF B1 later next year</li>
	</ul>

	<h2>Building</h2>
	<p>
		Slowly rewriting <a href="https://github.com/itzi97/engine2d" target="_blank" rel="noopener">engine2d</a> —
		the flat ECS is in, spatial hashing for the broadphase is next.
	</p>

	<h2>Playing</h2>
	<ul class="icon-list">
		<li><Icon name="lucide:gamepad-2" class="li-icon" /><span><a href="https://www.grimdawn.com/" target="_blank" rel="noopener">Grim Dawn</a> &mdash; first run, base game, no DLCs yet</span></li>
		<li><Icon name="lucide:gamepad-2" class="li-icon" /><span><a href="https://www.square-enix.com/ffvii/en-us/games/remake-intergrade/" target="_blank" rel="noopener">Final Fantasy VII Remake Intergrade</a> &mdash; working through it</span></li>
		<li><Icon name="lucide:gamepad-2" class="li-icon" /><span><a href="https://www.dofus.com/en" target="_blank" rel="noopener">Dofus</a> &mdash; my childhood MMORPG, currently in its Dofus&nbsp;3 incarnation</span></li>
	</ul>

	<h2>Reading</h2>
	<ul class="icon-list">
		<li><Icon name="lucide:book-open" class="li-icon" /><span><em>Dragon Rider</em> &mdash; Cornelia Funke</span></li>
	</ul>

	<h2>Practicing</h2>
	<p>On the piano at the moment:</p>
	<ul class="icon-list">
		<li><Icon name="lucide:piano" class="li-icon" /><span>Chopin &mdash; Waltz in C&sharp; minor, Op.&nbsp;64 No.&nbsp;2</span></li>
		<li><Icon name="lucide:piano" class="li-icon" /><span>Chopin &mdash; Waltz in A minor</span></li>
		<li><Icon name="lucide:piano" class="li-icon" /><span>Mozart &mdash; Sonata in C, K.&nbsp;545</span></li>
	</ul>

	{fitness.updated && (
		<>
			<h2>Moving</h2>
			<div class="fitness">
				<p class="fitness-line">
					<span class="fitness-label">{monthLabel}</span>
					{fmt(fitness.month.km)} km · {fmt(fitness.month.hours)} h · {fitness.month.activities} activities · {fmt(fitness.month.kcal)} kcal{fitness.month.steps != null && ` · ${fmt(fitness.month.steps)} steps`}
				</p>
				<p class="fitness-src">aggregates from my Garmin, updated with this page</p>
			</div>
		</>
	)}

	<style>
		.eyebrow {
			font-family: var(--font-mono);
			color: var(--accent);
			font-size: 0.85rem;
			margin-bottom: 0.4rem;
			margin-top: 0;
		}
		.updated {
			color: var(--text-muted);
			font-size: 0.85em;
		}
		h2 {
			font-family: var(--font-mono);
			font-size: 0.95em;
			color: var(--accent);
			margin-top: 2.4em;
			padding-bottom: 0.4em;
			border-bottom: 1px solid var(--border);
		}
		h2::before {
			content: '## ';
			color: var(--text-muted);
		}
		ul {
			padding-left: 1.25em;
			display: flex;
			flex-direction: column;
			gap: 0.3em;
		}
		li {
			font-size: 0.92em;
		}
		.icon-list {
			list-style: none;
			padding-left: 0;
			gap: 0.45em;
		}
		.icon-list li {
			display: flex;
			align-items: baseline;
			gap: 0.55em;
		}
		.icon-list .li-icon {
			width: 1em;
			height: 1em;
			flex-shrink: 0;
			color: var(--accent);
			transform: translateY(0.15em);
		}
		.fitness {
			border: 1px solid var(--border);
			border-left: 3px solid var(--accent);
			border-radius: 6px;
			background: var(--surface);
			padding: 0.9em 1.1em;
		}
		.fitness-line {
			font-family: var(--font-mono);
			font-size: 0.85em;
			margin: 0 0 0.35em;
		}
		.fitness-label {
			color: var(--accent);
			margin-right: 0.9em;
		}
		.fitness-src {
			margin: 0.5em 0 0;
			font-size: 0.72em;
			color: var(--text-muted);
		}
	</style>
</PageLayout>
