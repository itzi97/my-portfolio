---
/**
 * Frames any image (or content) as a terminal window so screenshots feel
 * native to the site instead of punched through it.
 *
 * The third titlebar dot is a working fullscreen button (macOS green-light
 * tradition). Note: inside fullscreen the browser reserves Esc for exiting.
 *
 * Usage (in .astro pages or .mdx posts):
 *   <TermWindow title="~/screenshots/engine2d-breakout.gif">
 *     <img src={...} alt="Breakout running in engine2d" />
 *   </TermWindow>
 */
interface Props {
	title?: string;
}
const { title = '~/screenshot.png' } = Astro.props;
---

<figure class="term-window">
	<div class="tw-bar">
		<span class="tw-dot tw-dot-hot" aria-hidden="true"></span>
		<span class="tw-dot" aria-hidden="true"></span>
		<button class="tw-dot tw-fullscreen" aria-label="Toggle fullscreen" title="Fullscreen"></button>
		<span class="tw-title">{title}</span>
	</div>
	<div class="tw-body">
		<slot />
	</div>
</figure>

<script>
	document.querySelectorAll<HTMLButtonElement>('.term-window .tw-fullscreen').forEach((btn) => {
		if (!document.fullscreenEnabled) {
			btn.style.pointerEvents = 'none';
			btn.style.cursor = 'default';
			btn.classList.remove('tw-fullscreen');
			return;
		}
		btn.addEventListener('click', () => {
			const body = btn.closest('.term-window')?.querySelector('.tw-body');
			if (!document.fullscreenElement) {
				body?.requestFullscreen?.();
			} else {
				document.exitFullscreen();
			}
		});
	});
</script>

<style>
	.term-window {
		margin: 0 0 1.5em;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		overflow: hidden;
	}
	.tw-bar {
		display: flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.5em 0.9em;
		border-bottom: 1px solid var(--border);
	}
	.tw-dot {
		width: 0.65em;
		height: 0.65em;
		border-radius: 50%;
		background: var(--border);
		border: none;
		padding: 0;
		flex-shrink: 0;
	}
	.tw-dot-hot {
		background: var(--accent-hot);
	}
	.tw-fullscreen {
		cursor: pointer;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.tw-fullscreen:hover {
		background: var(--accent);
		transform: scale(1.25);
	}
	.tw-title {
		margin-left: 0.5em;
		font-family: var(--font-mono);
		font-size: 0.75em;
		color: var(--text-muted);
	}
	.tw-body :global(img) {
		display: block;
		width: 100%;
		border: none;
		border-radius: 0;
		margin: 0;
	}
	.tw-body:fullscreen {
		background: #000;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.tw-body:fullscreen :global(iframe) {
		width: 100% !important;
		height: 100% !important;
		aspect-ratio: auto !important;
	}
	.tw-body:fullscreen :global(img) {
		width: auto;
		max-width: 100%;
		max-height: 100%;
	}
	.tw-body :global(figcaption),
	.term-window :global(figcaption) {
		font-size: 0.78em;
		color: var(--text-muted);
		padding: 0.5em 0.9em;
	}
</style>
